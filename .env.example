# Скопируйте этот файл в .env. Файл .env в git не попадает.

# Какая LLM используется для API, интерфейса и batch: disabled | ollama
# disabled (по умолчанию, основной режим) — данные игроков никуда не отправляются, работает логика без LLM.
# ollama — локальная модель, данные не покидают компьютер.
# gemini здесь НЕ работает: сервер и predict с ним не запускаются — Gemini Free Tier запрещён для реальных тикетов.
LLM_PROVIDER=disabled

# --- Google Gemini (бесплатный тариф): ТОЛЬКО для экспериментов на синтетике ---
# Используется лишь командой python -m scripts.eval_drafts --provider gemini (16 выдуманных обращений).
# Ключ из Google AI Studio, проект БЕЗ привязанного Billing. Можно оставить пустым.
GEMINI_API_KEY=
# Только модели из списка в app/services/llm_config.py, иначе приложение не запустится.
GEMINI_MODEL=gemini-3.1-flash-lite

# --- Локальная LLM через Ollama (данные не покидают компьютер) ---
# Модель нужно скачать заранее: ollama pull qwen2.5:3b (приложение ничего не скачивает само).
# Проверено 2026-10-31: qwen2.5:3b на эталоне хуже режима без LLM (категория 67.5% против 85%), см. FINAL_AUDIT.md.
# Облегчённая альтернатива qwen2.5:1.5b не проверялась.
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
# Своё время ожидания для Ollama (локальная модель медленнее облака). Пусто — как LLM_TIMEOUT_SECONDS.
OLLAMA_TIMEOUT_SECONDS=15
# Окно контекста. Не уменьшайте ниже 4096: промпт ~2100 токенов, а по умолчанию Ollama даёт только 2048.
OLLAMA_NUM_CTX=4096
# Максимум токенов ответа (обрезанный JSON считается ошибкой и уходит в запасной режим)
OLLAMA_NUM_PREDICT=512
# Сколько держать модель в памяти после запроса
OLLAMA_KEEP_ALIVE=10m

# Для каких языков использовать черновик модели (остальные — ручной шаблон на языке игрока).
# Пусто = по умолчанию: Ollama — НИ ДЛЯ КАКОГО (слепая оценка: свои черновики qwen2.5:3b 2.94/5 против 3.74 у шаблонов,
# треть с выдуманными фактами; kk/uz бессвязные); Gemini (только синтетика) — все 6. Пример: LLM_DRAFT_LANGS=ru,en
LLM_DRAFT_LANGS=

# Общий бюджет времени на ответ LLM, включая повторы (ради p95 ≤ 5 с)
LLM_TIMEOUT_SECONDS=4
# Сколько раз повторять при сетевой ошибке или 5xx (429/403/400 не повторяются)
LLM_MAX_RETRIES=1

# Оценка стоимости: $ за 1 млн токенов. 0 — бесплатный тариф / Ollama.
# Чтобы оценить, сколько стоил бы прогон на платном тарифе, впишите цены со страницы провайдера.
# На само использование API эти числа не влияют.
LLM_PRICE_INPUT_PER_M=0
LLM_PRICE_OUTPUT_PER_M=0
